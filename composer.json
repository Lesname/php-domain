{
  "name": "lesname/domain",
  "license": "MIT",
  "require": {
    "php": "^8.5.0",
    "ext-mbstring": "*",

    "lesname/value-object": "^0.7.0",

    "doctrine/dbal": "^4.0.0",

    "psr/http-message": "^2.0.0",
    "psr/container": "^2.0.0"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.0",

    "phpunit/phpunit": "^13.0.0",

    "vimeo/psalm": "^7.0.0-beta19",

    "phpstan/phpstan": "^2.0.0",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "LesDomain\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesDomainTest\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
